[project]
sub_id = "612edeec"
name = "resume-multi-agent"
requires = ["nodejs-24", "python-3.12"]
project_type = "web"
version = "0.0.35"
entrypoint = "backend/app/main.py"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/run.sh"]

[deploy]
build = ["bash", "scripts/deploy_setup.sh"]
run = ["bash", "scripts/deploy_run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true

[subprojects]
path = ["."]